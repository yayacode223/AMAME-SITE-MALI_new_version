# Modèle des variables d'environnement — ce fichier ne contient AUCUN secret.
#
# En local      : copier en .env à la racine, puis remplir. Le .env n'est jamais commité.
# En production : ne pas créer de fichier. Saisir chaque valeur dans les variables de la
#                 stack Portainer correspondante (« amame » ou « amame-ops »).

# ══════════════════════════════════════════════════════════════════════════════
#  STACK « amame » — application (docker-compose.yml)
# ══════════════════════════════════════════════════════════════════════════════

# ── Images ────────────────────────────────────────────────────────────────────
# Tags versionnés, jamais « latest ». Retour arrière : remettre le tag précédent.
BACKEND_IMAGE_TAG=backend-v1.1
FRONTEND_IMAGE_TAG=frontend-v1.1

# ── Base de données ───────────────────────────────────────────────────────────
# ATTENTION : PostgreSQL ne lit cette variable qu'à la création du volume.
# Sur une base existante, changer le mot de passe dans cet ordre :
#   1. docker exec amame-database psql -U postgres -c "ALTER USER postgres PASSWORD '<nouveau>'"
#   2. mettre la même valeur ici, puis mettre la stack à jour
#   3. reporter la valeur dans BACKUP_DATABASE_URL et SCRAPER_DATABASE_URL (stack amame-ops)
# Une valeur différente du mot de passe réel empêche le backend de démarrer.
POSTGRES_PASSWORD=<mot de passe fort>

# ── JWT ───────────────────────────────────────────────────────────────────────
# Générer avec : openssl rand -base64 32
JWT_SECRET=<générer avec: openssl rand -base64 32>
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# ── Site et cookies ───────────────────────────────────────────────────────────
# Valeurs locales par défaut. En production : FRONTEND=https://amame.ml, COOKIE_SECURE=true.
FRONTEND=http://localhost
COOKIE_DOMAIN=
COOKIE_SECURE=false

# ── Premier administrateur ────────────────────────────────────────────────────
# Créé au démarrage seulement si la table des utilisateurs est VIDE et si les deux
# valeurs sont renseignées. À laisser vides en temps normal ; à retirer après usage.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ── Email SMTP Gmail ──────────────────────────────────────────────────────────
# Prérequis : activer la 2FA Gmail, puis générer un App Password sur
# https://myaccount.google.com/apppasswords  (Type: Mail, Appareil: Autre)
# Le mot de passe est 16 caractères SANS espaces (ex: abcdabcdabcdabcd)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=votre-adresse@gmail.com
MAIL_PASSWORD=<App Password 16 chars sans espaces>
MAIL_FROM=votre-adresse@gmail.com

# Passer à true pour voir l'intégralité de la conversation SMTP dans les logs
# Utile pour diagnostiquer les problèmes d'envoi — désactiver en prod
MAIL_DEBUG=false

# ── Supervision ───────────────────────────────────────────────────────────────
# pgAdmin, Grafana et Prometheus n'écoutent que sur 127.0.0.1 : accès par tunnel SSH,
# par exemple : ssh -L 3001:127.0.0.1:3001 utilisateur@serveur
PGADMIN_PASSWORD=<mot de passe fort>
# N'est appliqué qu'à la création du volume Grafana : sur une installation existante,
# changer le mot de passe du compte « admin » dans l'interface de Grafana.
GRAFANA_ADMIN_PASSWORD=<mot de passe fort>

# ══════════════════════════════════════════════════════════════════════════════
#  STACK « amame-ops » — sauvegardes et scrapers (ops/docker-compose.yml)
#  Mode d'emploi : ops/README.md
#  Ces valeurs ne vont JAMAIS dans la stack « amame ».
# ══════════════════════════════════════════════════════════════════════════════

OPS_IMAGE_TAG=ops-v1.0
SCRAPER_IMAGE_TAG=scraper-v1.1
# Version majeure de la base sauvegardée : 15 sur le VPS, 17 une fois sur Neon
OPS_PG_MAJOR=15

# Base à sauvegarder. Tant qu'elle est sur le VPS :
BACKUP_DATABASE_URL=postgresql://postgres:<mot de passe>@database:5432/amame_db
SCRAPER_DATABASE_URL=postgresql://postgres:<mot de passe>@database:5432/amame_db

# Phrase de chiffrement des sauvegardes (openssl rand -base64 48).
# À conserver AUSSI hors du serveur : sans elle, les sauvegardes sont illisibles.
BACKUP_PASSPHRASE=<phrase longue générée>

# Heures des sauvegardes, en UTC (heure de Bamako), au format HH:MM séparées par des espaces
BACKUP_DB_SCHEDULE=02:30 14:30
BACKUP_DB_RETENTION_DAYS=30

# Zone Bunny réservée aux sauvegardes (Francfort, sans Pull Zone)
BUNNY_STORAGE_ENDPOINT=https://storage.bunnycdn.com
BUNNY_BACKUP_ZONE=amame-backups
BUNNY_BACKUP_ZONE_KEY=<mot de passe de la zone amame-backups>

# Chemin RÉEL du dossier des uploads sur l'hôte (Portainer : conteneur backend > Volumes)
UPLOADS_HOST_PATH=/chemin/reel/vers/uploads
# Réseau Docker de la stack « amame » (docker network ls)
AMAME_NETWORK=amame_common_net
