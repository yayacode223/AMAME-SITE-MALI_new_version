# Modèle des variables d'environnement — ce fichier ne contient AUCUN secret.
#
# En local      : copier en .env à la racine, puis remplir. Le .env n'est jamais commité.
# En production : ne pas créer de fichier. Saisir chaque valeur dans les variables de la
#                 stack Portainer correspondante (« amamestack » ou « amame-ops »), dont le
#                 contenu se colle depuis deploy/portainer/amamestack.yml et amame-ops.yml.
#                 NE PAS charger CE fichier dans Portainer : tags d'une autre étape, valeurs de
#                 développement (cookies, FRONTEND) et clés de sauvegarde mélangées aux variables
#                 de l'application. Partir de deploy/portainer/amamestack.env.example et
#                 amame-ops.env.example : seulement les variables de chaque stack, sans secret.

# ══════════════════════════════════════════════════════════════════════════════
#  STACK « amame » — application (docker-compose.yml)
# ══════════════════════════════════════════════════════════════════════════════

# ── Images ────────────────────────────────────────────────────────────────────
# Tags versionnés, jamais « latest ». Retour arrière : remettre le tag précédent.
BACKEND_IMAGE_TAG=backend-v1.4
FRONTEND_IMAGE_TAG=frontend-v1.3

# ── Base de données ───────────────────────────────────────────────────────────
# ATTENTION : PostgreSQL ne lit cette variable qu'à la création du volume.
# Sur une base existante, changer le mot de passe dans cet ordre :
#   1. docker exec amame-database psql -U postgres -c "ALTER USER postgres PASSWORD '<nouveau>'"
#   2. mettre la même valeur ici, puis mettre la stack à jour
#   3. reporter la valeur dans BACKUP_DATABASE_URL et SCRAPER_DATABASE_URL (stack amame-ops)
# Une valeur différente du mot de passe réel empêche le backend de démarrer.
POSTGRES_PASSWORD=<mot de passe fort>

# Connexion du backend. Tant que la base est celle du VPS, NE RIEN DÉFINIR ici : le backend
# se connecte à « database » avec le compte postgres et POSTGRES_PASSWORD.
# À renseigner le jour où la base change (Neon) : les cinq ensemble, sans nouvelle image.
#   DATABASE_URL                 URL JDBC (jdbc:postgresql://…), et non l'URL « postgresql:// »
#                                des scrapers et des sauvegardes de la stack amame-ops.
#   DATABASE_USERNAME/PASSWORD   compte applicatif : lit et écrit les données, rien d'autre.
#   DATABASE_MIGRATION_*         compte de Flyway : le seul à modifier le schéma.
# DATABASE_URL=jdbc:postgresql://<hôte>/amame_db?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory
# DATABASE_USERNAME=amame_app
# DATABASE_PASSWORD=<mot de passe de amame_app>
# DATABASE_MIGRATION_USERNAME=amame_owner
# DATABASE_MIGRATION_PASSWORD=<mot de passe de amame_owner>

# Pool de connexions du backend. Durées en millisecondes.
# Profil « veille » (ci-dessous, valeurs par défaut) : aucune connexion gardée ouverte, une base
# facturée au temps d'éveil peut s'endormir. Convient aussi à la base du VPS.
# Profil « toujours actif » : DB_POOL_MIN_IDLE=2, DB_POOL_IDLE_TIMEOUT=300000, DB_POOL_KEEPALIVE_TIME=120000
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=0
DB_POOL_IDLE_TIMEOUT=60000
DB_POOL_KEEPALIVE_TIME=0

# ── Fichiers ──────────────────────────────────────────────────────────────────
# local : fichiers sur le disque du serveur (seule valeur possible pour l'instant).
STORAGE_PROVIDER=local
# Base des URL des médias, sans « / » final. Lue par le backend ET par le frontend, au
# démarrage des conteneurs : la changer puis mettre la stack à jour suffit, sans nouvelle image.
# Vide : URL relatives (/uploads/…), servies par le site lui-même.
MEDIA_BASE_URL=
# Paramètres de redimensionnement ajoutés aux URL d'images. À laisser à false tant que
# Bunny Optimizer n'est pas activé : sans lui, ils ne feraient que fragmenter le cache du CDN.
MEDIA_OPTIMIZER_ENABLED=false
# Purge : un fichier remplacé ou supprimé est inscrit dans une file (en base), puis effacé du
# stockage par une tâche de nuit, après la rétention. Désactivée par défaut : la file se remplit
# sans rien effacer. À activer (true) EN PRODUCTION UNIQUEMENT : jamais sur une copie de la base
# branchée sur le stockage de production.
STORAGE_PURGE_ENABLED=false
# Délai avant effacement. Toujours plus long que la fenêtre de restauration de la base :
# 10 jours (10d) pour Neon Free ou Launch, 31 jours au moins avec une restauration de 30 jours.
# Un nombre sans unité compte des jours ; minimum 1 jour.
STORAGE_PURGE_RETENTION=10d
# Format cron de Spring, en UTC, dans la même fenêtre de nuit que les autres tâches.
STORAGE_PURGE_SCHEDULE=0 30 2 * * *
# Bunny Storage, lu seulement avec STORAGE_PROVIDER=bunny : PRODUCTION UNIQUEMENT (DT7), à saisir
# dans les variables de la stack amamestack au moment de la bascule (étape 3.5). En local, laisser
# ces lignes commentées : un développeur n'écrit jamais dans les zones de production.
# Avec STORAGE_PROVIDER=bunny, MEDIA_BASE_URL doit désigner le CDN (https://media.amame.ml), jamais
# le site lui-même : le frontend y redirige /uploads/.
# BUNNY_STORAGE_ENDPOINT=https://storage.bunnycdn.com
# BUNNY_PUBLIC_ZONE=amame-public
# BUNNY_PUBLIC_ZONE_KEY=<mot de passe d'écriture de la zone publique>
# BUNNY_PRIVATE_ZONE=amame-private
# BUNNY_PRIVATE_ZONE_KEY=<mot de passe d'écriture de la zone privée>

# ── Réveils de la base ────────────────────────────────────────────────────────
# Cache des listes publiques (articles, bourses, concours…). 0 = désactivé.
# Une durée (10m, 1h…) l'active : ces listes sont alors servies sans interroger la base, et le
# cache est vidé à chaque modification par un administrateur. Premier levier si la base
# consomme trop de temps d'éveil ; les compteurs de vues affichés prennent alors ce retard.
PUBLIC_LISTS_CACHE_TTL=0
# Nettoyage nocturne des jetons de session expirés : format cron de Spring, en UTC.
# À garder dans la même fenêtre que les sauvegardes (BACKUP_DB_SCHEDULE) : un seul réveil par nuit.
AUTH_TOKEN_CLEANUP_SCHEDULE=0 30 2 * * *

# ── JWT ───────────────────────────────────────────────────────────────────────
# Générer avec : openssl rand -base64 32
JWT_SECRET=<générer avec: openssl rand -base64 32>
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# ── Site et cookies ───────────────────────────────────────────────────────────
# Valeurs locales par défaut. En production : FRONTEND=https://amame.ml, COOKIE_SECURE=true, et
# COOKIE_DOMAIN vide aussi (cookies sans domaine, jamais envoyés à un sous-domaine, écart E50).
FRONTEND=http://localhost
COOKIE_DOMAIN=
COOKIE_SECURE=false

# ── Premier administrateur ────────────────────────────────────────────────────
# Créé au démarrage seulement si la table des utilisateurs est VIDE et si les deux
# valeurs sont renseignées. À laisser vides en temps normal ; à retirer après usage.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ── Email SMTP Gmail ──────────────────────────────────────────────────────────
# Prérequis : activer la 2FA Gmail, puis générer un App Password sur
# https://myaccount.google.com/apppasswords  (Type: Mail, Appareil: Autre)
# Le mot de passe est 16 caractères SANS espaces (ex: abcdabcdabcdabcd)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=votre-adresse@gmail.com
MAIL_PASSWORD=<App Password 16 chars sans espaces>
MAIL_FROM=votre-adresse@gmail.com

# Passer à true pour voir l'intégralité de la conversation SMTP dans les logs
# Utile pour diagnostiquer les problèmes d'envoi — désactiver en prod
MAIL_DEBUG=false

# ── Administration de la base ─────────────────────────────────────────────────
# pgAdmin n'écoute que sur 127.0.0.1 : accès par tunnel SSH,
# par exemple : ssh -L 5050:127.0.0.1:5050 utilisateur@serveur
# Absent de la stack de production (deploy/portainer/amamestack.yml) : sans SSH, injoignable.
PGADMIN_PASSWORD=<mot de passe fort>

# ── Production uniquement (deploy/portainer/amamestack.yml) ───────────────────
# Dans la stack de production, BACKEND_IMAGE_TAG et FRONTEND_IMAGE_TAG n'ont pas de valeur
# par défaut : les saisir à chaque étape (étape 0 : backend-v1.1 et frontend-v1.1).
# Chemin ABSOLU des uploads sur l'hôte, monté dans le backend et le frontend. Même valeur que
# UPLOADS_HOST_PATH de la stack amame-ops (plus bas), à saisir dans les deux stacks.
# Limite mémoire du conteneur backend : 512M par défaut ; 768M pendant l'étape 0 (backend-v1.1).
# BACKEND_MEMORY_LIMIT=768M

# ══════════════════════════════════════════════════════════════════════════════
#  STACK « amame-ops » — sauvegardes et scrapers (ops/docker-compose.yml)
#  Mode d'emploi : ops/README.md
#  Ces valeurs ne vont JAMAIS dans la stack « amame ».
# ══════════════════════════════════════════════════════════════════════════════

OPS_IMAGE_TAG=ops-v1.2
SCRAPER_IMAGE_TAG=scraper-v1.1
# Version majeure de la base sauvegardée : 15 sur le VPS, 17 une fois sur Neon
OPS_PG_MAJOR=15

# Base à sauvegarder. Tant qu'elle est sur le VPS, désignée par le nom de son conteneur,
# unique sur l'hôte (le réseau de production est partagé avec d'autres conteneurs) :
BACKUP_DATABASE_URL=postgresql://postgres:<mot de passe>@amame-database:5432/amame_db
SCRAPER_DATABASE_URL=postgresql://postgres:<mot de passe>@amame-database:5432/amame_db

# Phrase de chiffrement des sauvegardes (openssl rand -base64 48).
# À conserver AUSSI hors du serveur : sans elle, les sauvegardes sont illisibles.
BACKUP_PASSPHRASE=<phrase longue générée>

# Heures des sauvegardes, en UTC (heure de Bamako), au format HH:MM séparées par des espaces
BACKUP_DB_SCHEDULE=02:30 14:30
BACKUP_DB_RETENTION_DAYS=30

# Zone Bunny réservée aux sauvegardes (Francfort, sans Pull Zone). En production, elle s'appelle
# « amamestoragezone » (écart E40 du suivi).
BUNNY_STORAGE_ENDPOINT=https://storage.bunnycdn.com
BUNNY_BACKUP_ZONE=amame-backups
BUNNY_BACKUP_ZONE_KEY=<mot de passe de la zone amame-backups>

# Zones de l'application (étape 3) : copie vers Bunny, réconciliation, sauvegarde depuis Bunny.
BUNNY_PUBLIC_ZONE=amame-public
BUNNY_PRIVATE_ZONE=amame-private
# Mots de passe d'ÉCRITURE : pour copy-to-bunny.sh, pendant la migration seulement ; à retirer de
# cette stack au nettoyage de l'étape 6.
BUNNY_PUBLIC_ZONE_KEY=<mot de passe d'écriture de la zone publique>
BUNNY_PRIVATE_ZONE_KEY=<mot de passe d'écriture de la zone privée>
# Mots de passe en LECTURE SEULE (« Read-only password ») : réconciliation et sauvegarde.
BUNNY_PUBLIC_ZONE_READ_KEY=<mot de passe en lecture seule de la zone publique>
BUNNY_PRIVATE_ZONE_READ_KEY=<mot de passe en lecture seule de la zone privée>
# Source des fichiers sauvegardés : disk jusqu'à la bascule vers Bunny (étape 3.5), bunny ensuite.
BACKUP_FILES_SOURCE=disk

# Chemin RÉEL du dossier des uploads sur l'hôte (Portainer : conteneur backend > Volumes)
UPLOADS_HOST_PATH=/chemin/reel/vers/uploads
# Réseau Docker de la stack « amame » (docker network ls). En production : common_net,
# valeur par défaut de deploy/portainer/amame-ops.yml.
AMAME_NETWORK=amame_common_net
