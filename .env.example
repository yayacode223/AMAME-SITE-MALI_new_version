# Copier ce fichier en .env et remplir les valeurs réelles
# Le fichier .env ne doit JAMAIS être commité (voir .gitignore)

# ── JWT ───────────────────────────────────────────────────────────────────────
# Générer avec : openssl rand -base64 32
JWT_SECRET=<générer avec: openssl rand -base64 32>
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# ── Email SMTP Gmail ──────────────────────────────────────────────────────────
# Prérequis : activer la 2FA Gmail, puis générer un App Password sur
# https://myaccount.google.com/apppasswords  (Type: Mail, Appareil: Autre)
# Le mot de passe est 16 caractères SANS espaces (ex: abcdabcdabcdabcd)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=votre-adresse@gmail.com
MAIL_PASSWORD=<App Password 16 chars sans espaces>
MAIL_FROM=votre-adresse@gmail.com

# Passer à true pour voir l'intégralité de la conversation SMTP dans les logs
# Utile pour diagnostiquer les problèmes d'envoi — désactiver en prod
MAIL_DEBUG=false
