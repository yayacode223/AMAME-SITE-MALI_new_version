BACKEND_IMAGE_TAG=backend-v1.4
FRONTEND_IMAGE_TAG=frontend-v1.7
POSTGRES_PASSWORD=<mot de passe de l'ancienne base, gardée en lecture seule jusqu'à l'étape 6>
DATABASE_URL=jdbc:postgresql://<hôte direct de la branche Neon production, sans -pooler>/amame_db?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory
DATABASE_USERNAME=amame_app
DATABASE_PASSWORD=<mot de passe de amame_app>
DATABASE_MIGRATION_USERNAME=amame_owner
DATABASE_MIGRATION_PASSWORD=<mot de passe de amame_owner>
STORAGE_PROVIDER=bunny
MEDIA_BASE_URL=https://amamemedia.b-cdn.net
BUNNY_PUBLIC_ZONE=amame-public-storage-zone
BUNNY_PUBLIC_ZONE_KEY=<mot de passe d'écriture de la zone publique>
BUNNY_PRIVATE_ZONE=amame-private-storage-zone
BUNNY_PRIVATE_ZONE_KEY=<mot de passe d'écriture de la zone privée>
STORAGE_PURGE_ENABLED=false
PUBLIC_LISTS_CACHE_TTL=10m
JWT_SECRET=<openssl rand -base64 32>
MAIL_USERNAME=<adresse Gmail d'envoi>
MAIL_PASSWORD=<mot de passe d'application Gmail, 16 caractères sans espaces>
MAIL_FROM=<adresse Gmail d'envoi>
UPLOADS_HOST_PATH=/data/compose/64/backend/uploads
BACKEND_MEMORY_LIMIT=768M
