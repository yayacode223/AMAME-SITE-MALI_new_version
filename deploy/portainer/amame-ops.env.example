BACKUP_DATABASE_URL=postgresql://postgres:<mot de passe de la base>@amame-database:5432/amame_db
SCRAPER_DATABASE_URL=postgresql://postgres:<mot de passe de la base>@amame-database:5432/amame_db
BACKUP_PASSPHRASE=<phrase de chiffrement des sauvegardes, ne jamais la changer>
BUNNY_BACKUP_ZONE=amamestoragezone
BUNNY_BACKUP_ZONE_KEY=<Access Key de la zone amamestoragezone>
UPLOADS_HOST_PATH=/data/compose/64/backend/uploads
BUNNY_PUBLIC_ZONE=amame-public
BUNNY_PRIVATE_ZONE=amame-private
BUNNY_PUBLIC_ZONE_KEY=<mot de passe d'écriture de la zone publique, pendant la migration seulement>
BUNNY_PRIVATE_ZONE_KEY=<mot de passe d'écriture de la zone privée, pendant la migration seulement>
BUNNY_PUBLIC_ZONE_READ_KEY=<mot de passe en lecture seule de la zone publique>
BUNNY_PRIVATE_ZONE_READ_KEY=<mot de passe en lecture seule de la zone privée>
BACKUP_FILES_SOURCE=disk
